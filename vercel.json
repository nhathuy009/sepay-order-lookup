{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python@4.8.0" },
    { "src": "api/telegram.py", "use": "@vercel/python@4.8.0" },
    { "src": "api/hlsproxy.py", "use": "@vercel/python@4.8.0" },
    
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "ebook.html", "use": "@vercel/static" },
    { "src": "jotun.html", "use": "@vercel/static" },
    { "src": "123av.html", "use": "@vercel/static" },
    { "src": "indexplayer.html", "use": "@vercel/static" },
    { "src": "excel_auditor_quy_trinh.html", "use": "@vercel/static" },
    { "src": "C12_TS_editable.html", "use": "@vercel/static" },
    { "src": "app.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "index-new.html", "use": "@vercel/static" },
    { "src": "app-v2.css", "use": "@vercel/static" },
    { "src": "app-v2.js", "use": "@vercel/static" },
    { "src": "index-v3.html", "use": "@vercel/static" },
    { "src": "app-v3.css", "use": "@vercel/static" },
    { "src": "app-v3.js", "use": "@vercel/static" }
  ],

  "routes": [
    { "src": "/api/telegram", "dest": "/api/telegram.py" },
    { "src": "/api/hlsproxy", "dest": "/api/hlsproxy.py" },
    { "src": "/api/resolve", "dest": "/api/hlsproxy.py" },

    { "src": "/api/(.*)", "dest": "/api/index.py" },

    { "src": "/app.css", "dest": "/app.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/app-v2.css", "dest": "/app-v2.css" },
    { "src": "/app-v2.js", "dest": "/app-v2.js" },
    { "src": "/v2/?", "dest": "/index-new.html" },
    { "src": "/app-v3.css", "dest": "/app-v3.css" },
    { "src": "/app-v3.js", "dest": "/app-v3.js" },
    { "src": "/v3/?", "dest": "/index-v3.html" },
    { "src": "/jotun", "dest": "/jotun.html" },
    { "src": "/123av", "dest": "/123av.html" },
    { "src": "/4k", "dest": "/indexplayer.html" },
    { "src": "/quytrinh", "dest": "/excel_auditor_quy_trinh.html" },
    { "src": "/c12", "dest": "/C12_TS_editable.html" },
    { "src": "/ebook", "dest": "/ebook.html" },

    { "src": "/v1/?", "dest": "/index.html" },

    { "src": "/(.*)", "dest": "/index-v3.html" }
  ],

  "regions": ["sin1"]
}
