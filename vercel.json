{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python@4.8.0" },
    { "src": "api/telegram.py", "use": "@vercel/python@4.8.0" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "ebook.html", "use": "@vercel/static" },
    { "src": "jotun.html", "use": "@vercel/static" },
    { "src": "excel_auditor_quy_trinh.html", "use": "@vercel/static" },
    { "src": "C12_TS_editable.html", "use": "@vercel/static" },
    { "src": "app.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/telegram", "dest": "/api/telegram.py" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/app.css", "dest": "/app.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/jotun", "dest": "/jotun.html" },
    { "src": "/quytrinh", "dest": "/excel_auditor_quy_trinh.html" },
    { "src": "/c12", "dest": "/C12_TS_editable.html" },
    { "src": "/ebook", "dest": "/ebook.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "regions": ["sin1"]
}
