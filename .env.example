# Sao chép thành .env (chạy local) hoặc đặt trong Vercel > Settings > Environment Variables.
# Sau khi thêm/đổi biến trên Vercel phải Redeploy để có hiệu lực.

# =============================================================================
# BẮT BUỘC — Tra cứu đơn hàng 10X / SOLOBIZ
# =============================================================================
LOGIN_EMAIL=your-email-here
LOGIN_PASSWORD=your-password-here

# Mật khẩu bảo vệ truy cập web app (khuyến nghị đặt; để trống = app công khai)
APP_ACCESS_TOKEN=doi-thanh-mot-chuoi-bi-mat

# =============================================================================
# Tra cứu hóa đơn điện tử SePay (tab "Tra cứu hóa đơn" + cột HĐ trong SePay v2)
# BẮT BUỘC nếu dùng chức năng này — API v1 (Bearer JWT)
# =============================================================================
EINVOICE_BASE_URL=https://xxxxxxxxxx.sepay-einvoice.com
EINVOICE_USERNAME=your-einvoice-username
# Plain text OK — code tự MD5 giống UI web. Hoặc dán sẵn chuỗi MD5 32 hex.
EINVOICE_PASSWORD=your-einvoice-password
# Ký hiệu mẫu hóa đơn dùng để lọc khi gọi API (mặc định C26MSL)
EINVOICE_SERIAL=C26MSL
# (Tùy chọn) idPub trên API list invoices — để trống nếu không cần
# EINVOICE_ID_PUB=

# =============================================================================
# SePay API — Tra cứu chuyển khoản / sao kê / danh sách tài khoản ngân hàng
# BẮT BUỘC nếu dùng tab "Tra cứu CK (SePay)"
# Lấy token tại: https://my.sepay.vn → API Token
# =============================================================================
SEPAY_API_TOKEN=your-sepay-api-token

# =============================================================================
# eHoadon (BKAV) — Tùy chọn: prefill form đăng nhập tab "Tạo hóa đơn eHoadon"
# User vẫn nhập tay được trên giao diện; 2 biến này chỉ giúp điền sẵn khi mở app.
# (Tên biến viết thường đúng như code đang đọc)
# =============================================================================
ehoadon_username=
ehoadon_password=

# =============================================================================
# Bot Telegram (@sepaycheckbot) — tùy chọn
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Danh sách Telegram user id được phép, ngăn bằng dấu phẩy. Để trống = ai cũng dùng được.
# Gõ /id cho bot để lấy ID của mình.
TELEGRAM_ALLOWED_IDS=
